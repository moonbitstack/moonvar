let quic_padded : Array[(UInt64, String)] = [
  (37UL, "4025"),
  (37UL, "80000025"),
  (37UL, "c000000000000025"),
  (15293UL, "7bbd"),
  (494878333UL, "9d7f3e7d"),
  (0UL, "4000"),
  (63UL, "403f"),
