name = "moonbitstack/moonvar"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonvar"

license = "Apache-2.0"

keywords = [ "varint", "leb128", "hpack", "endian", "moonbit" ]

description = "moonvar — how a number becomes bytes and back, for MoonBit: byte order for the fixed widths, and the variable-length integers of QUIC, HPACK, protobuf and MySQL, each a package of its own."

preferred_target = "wasm-gc"
